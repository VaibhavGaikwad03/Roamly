# ─── Place search (optional) ─────────────────────────────────────────────
# Without this, Roamly searches with OpenStreetMap (no key required).
# Create a browser (HTTP-referrer restricted) key with the "Places API (New)"
# enabled, then copy this file to `.env`:
VITE_GOOGLE_PLACES_KEY=

# ─── AI features (optional): smart add, insights, recommendations, planner ──
# Provide ONE of the following.
#
# A) Local / personal — call Groq directly from the browser (simplest).
#    Get a free key at https://console.groq.com/keys
#    Note: a browser key ships in the built page; fine for local/personal use.
VITE_GROQ_API_KEY=

# Optional: override the Groq model (default: llama-3.3-70b-versatile)
VITE_GROQ_MODEL=

# B) Public deploy — point at your own serverless proxy that holds the key
#    server-side (keeps the key out of the browser). If set, this wins over
#    VITE_GROQ_API_KEY. Your proxy receives { messages, json } and should
#    return an OpenAI-style chat completion.
VITE_AI_PROXY_URL=

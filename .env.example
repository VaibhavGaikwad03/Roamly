# ─── Supabase (REQUIRED — accounts + database) ───────────────────────────
# Create a free project at https://supabase.com, then run supabase/schema.sql
# in the SQL Editor. Copy these two values from:
#   Dashboard → Project Settings → API
# The anon key is safe in the browser: Row-Level Security limits every user to
# their own rows. Copy this file to `.env` and fill these in.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ─── AI proxy endpoint (optional) ────────────────────────────────────────
# Where the app sends AI requests. Defaults to "/api/ai" (the Netlify function
# in netlify/functions/ai.mjs, mapped by netlify.toml). Only override if you
# host the proxy elsewhere.
VITE_AI_PROXY_URL=

# ─── Server-side only (set in the Netlify dashboard, NOT here) ────────────
# The AI proxy function needs these as PLAIN (non-VITE) env vars so they never
# ship to the browser:
#   SUPABASE_URL                 = same as VITE_SUPABASE_URL
#   SUPABASE_ANON_KEY            = same as VITE_SUPABASE_ANON_KEY
#   SUPABASE_SERVICE_ROLE_KEY    = the "service_role" secret (Settings → API)
# The user's Groq key is stored per-account in the database and read only here,
# server-side — it is never exposed to the browser.

# ─── Place search (optional) ─────────────────────────────────────────────
# Without this, Roamly searches with OpenStreetMap (no key required).
# Create a browser (HTTP-referrer restricted) key with the "Places API (New)"
# enabled.
VITE_GOOGLE_PLACES_KEY=
